# Development: copy to .env.local; never commit actual values.
# Public browser configuration from YOUR OWN Supabase project settings.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side configuration for TanStack Start and authenticated MCP routes.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server ONLY, only if a trusted server action needs administration.
# NEVER prefix with VITE_ or place inside client/browser bundles.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET

# Google OAuth is optional and must be configured in Supabase Auth + Google.
# Keep false until redirect URLs and the provider are actually configured.
VITE_GOOGLE_AUTH_ENABLED=false
# Email/password sign-in can be tested before configuring the provider.

# NFS-e — SERVER ONLY. Keep disabled until the workshop's municipality/provider
# and tax regime have been confirmed. Never prefix certificate/password values with VITE_.
NFSE_PROVIDER=disabled
NFSE_AMBIENTE=homologacao
# Production is intentionally blocked unless this exact value is set server-side.
NFSE_ALLOW_PRODUCTION=no
# NFSE_CNPJ=ONLY_DIGITS
# NFSE_MUNICIPIO_IBGE=7_DIGITS
# NFSE_INSCRICAO_MUNICIPAL=...
# Código nacional do serviço com 6 dígitos, conforme tabela vigente.
# NFSE_CODIGO_SERVICO=010701
# Código municipal opcional com 3 dígitos, quando exigido pela parametrização.
# NFSE_CODIGO_SERVICO_MUNICIPAL=...
# Série numérica da DPS (1 a 99999).
# NFSE_SERIE_DPS=1601
# Perfil tributário: confirmar com a contabilidade antes de habilitar.
# NFSE_OP_SIMP_NAC=...
# NFSE_REG_AP_TRIB_SN=...
# NFSE_REG_ESP_TRIB=...
# NFSE_TRIB_ISSQN=...
# NFSE_TP_RET_ISSQN=...
# NFSE_API_BASE_URL=https://...
# NFSE_CERT_PFX_PATH=/run/secrets/ritmeia-nfse.pfx
# NFSE_CERT_PASSWORD=SERVER_ONLY_SECRET
